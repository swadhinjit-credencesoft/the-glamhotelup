# Next.js build-time configuration
# Copy this file to .env.local and adjust as needed.

# The Hotelmate availability API base URL.
# https://api.thehotelmate.co/api/thm
NEXT_PUBLIC_HOTELMATE_API_BASE_URL=https://api.thehotelmate.co/api/thm

# The Hotelmate property ID used for availability queries.
NEXT_PUBLIC_HOTELMATE_PROPERTY_ID=3624